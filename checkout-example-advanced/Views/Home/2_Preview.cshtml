@{
    ViewData["Title"] = "Adyen Checkout Cart";
  var paymentMethod = (ViewBag.PaymentMethod as string) ?? string.Empty;
    var paymentMethodName = (ViewBag.PaymentMethod as string) switch
    {
        "dropin" => "Drop-in",
        "card" => "Card",
        "ideal" => "iDEAL",
        "directEbanking" => "SOFORT",
        "ach" => "ACH",
        "klarna_paynow" => "Klarna - Pay now",
        "klarna" => "Klarna - Pay later",
        "klarna_account" => "Klarna - Slice it",
        _ => "Payment Method"
    };
      var paymentLogoCode = paymentMethod switch
      {
        "dropin" => "card",
        "card" => "card",
        "ideal" => "ideal",
        "directEbanking" => "sofort",
        "ach" => "ach",
        "klarna_paynow" => "klarna",
        "klarna" => "klarna",
        "klarna_account" => "klarna",
        _ => "card"
      };
      var paymentLogoUrl = $"https://checkoutshopper-test.cdn.adyen.com/checkoutshopper/images/logos/{paymentLogoCode}.svg";
}
<main class="preview-page">
  <section class="cart">
    <h2>Cart</h2>
    <div class="payment-method-display">
      <p class="payment-method-label">Payment Method:</p>
      <div class="payment-method-display-header">
        <div class="payment-method-logo-chip">
          <img src="@paymentLogoUrl" alt="@paymentMethodName logo" class="payment-method-logo" />
        </div>
        <p class="payment-method-name">@paymentMethodName</p>
      </div>
    </div>
    <div class="order-summary">
      <ul class="order-summary-list">
        <li class="order-summary-list-list-item">
          <img src="~/images/sunglasses.png" class="order-summary-list-list-item-image" alt="">
          <p class="order-summary-list-list-item-title">Sunglasses</p>
          <p class="order-summary-list-list-item-price">€ 50.00</p>
        </li>
        <li class="order-summary-list-list-item">
          <img src="~/images/headphones.png" class="order-summary-list-list-item-image" alt="">
          <p class="order-summary-list-list-item-title">Headphones</p>
          <p class="order-summary-list-list-item-price">€ 50.00</p>
        </li>
      </ul>
      <div class="order-summary-total">
        <span class="cart-footer-label">Total:</span>
        <span class="cart-footer-amount">€ 100.00</span>
      </div>
    </div>
    <div class="cart-footer">
      <a asp-area="" asp-controller="Home" asp-action="Checkout" asp-route-id="@ViewBag.PaymentMethod" class="button">
        Continue to checkout
      </a>
    </div>
  </section>
</main>